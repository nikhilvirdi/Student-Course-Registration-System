// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// 1. Students Table
model Student {
  student_id    String       @id @default(uuid())
  name          String
  email         String       @unique
  password      String
  semester      Int
  department_id String
  department    Department   @relation(fields: [department_id], references: [department_id])
  enrollments   Enrollment[]
  tasks         Task[]
  notifications Notification[]
  documents     Document[]
  created_at    DateTime     @default(now())
  updated_at    DateTime     @updatedAt
}

// 2. Admins Table
model Admin {
  admin_id   String   @id @default(uuid())
  name       String
  email      String   @unique
  password   String
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
}

// 3. Departments Table
model Department {
  department_id   String    @id @default(uuid())
  department_name String    @unique
  students        Student[]
  courses         Course[]
}

// 4. Faculty Table
model Faculty {
  faculty_id   String   @id @default(uuid())
  faculty_name String
  email        String   @unique
  courses      Course[]
}

// 5. Courses Table
model Course {
  course_id       String         @id @default(uuid())
  course_name     String
  description     String         @db.Text
  credits         Int
  max_seats       Int
  available_seats Int
  faculty_id      String
  faculty         Faculty        @relation(fields: [faculty_id], references: [faculty_id])
  department_id   String
  department      Department     @relation(fields: [department_id], references: [department_id])
  enrollments     Enrollment[]

  // Scheduling & Academic Fields
  course_code     String?
  schedule_days   String?
  schedule_time   String?
  room            String?
  semester_label  String?

  // Prerequisite Relationships
  prerequisites   Prerequisite[] @relation("CourseToPrerequisite")
  required_for    Prerequisite[] @relation("PrerequisiteToCourse")
}

// 6. Enrollments Table (Many-to-Many Junction)
model Enrollment {
  enrollment_id   String   @id @default(uuid())
  student_id      String
  course_id       String
  enrollment_date DateTime @default(now())
  status          String   @default("ACTIVE") // ACTIVE | COMPLETED | DROPPED
  
  student         Student  @relation(fields: [student_id], references: [student_id])
  course          Course   @relation(fields: [course_id], references: [course_id])
  grade           Grade?

  @@unique([student_id, course_id]) // Constraint: Duplicate enrollment prevention
}

// 6b. Grades Table
model Grade {
  grade_id      String     @id @default(uuid())
  enrollment_id String     @unique   // One grade per enrollment
  enrollment    Enrollment @relation(fields: [enrollment_id], references: [enrollment_id])
  
  marks_obtained Float      // Raw marks (e.g., 85.5)
  grade_letter   String     // e.g., "A+", "B", "F"
  grade_points   Float      // e.g., 10.0, 8.0, 0.0 (for GPA calculation)
  
  graded_at     DateTime   @default(now())
  updated_at    DateTime   @updatedAt
}

// 7. Prerequisites Table (Self-referencing Junction)
model Prerequisite {
  prerequisite_id        String @id @default(uuid())
  course_id              String
  prerequisite_course_id String

  course                 Course @relation("CourseToPrerequisite", fields: [course_id], references: [course_id])
  prerequisite_course    Course @relation("PrerequisiteToCourse", fields: [prerequisite_course_id], references: [course_id])

  @@unique([course_id, prerequisite_course_id]) // Constraint: Unique prerequisite mapping
}

// 8. Tasks Table
model Task {
  task_id     String   @id @default(uuid())
  title       String
  category    String   @default("Other")
  priority    String   @default("Medium")
  due_date    String?
  completed   Boolean  @default(false)
  student_id  String
  student     Student  @relation(fields: [student_id], references: [student_id])
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt
}

// 9. Notifications Table
model Notification {
  notification_id String   @id @default(uuid())
  title           String
  message         String
  type            String   @default("info") // info, success, warning, error
  read            Boolean  @default(false)
  student_id      String
  student         Student  @relation(fields: [student_id], references: [student_id])
  created_at      DateTime @default(now())
}

// 10. Documents Table
model Document {
  document_id String   @id @default(uuid())
  name        String
  type        String
  size        String
  url         String
  student_id  String
  student     Student  @relation(fields: [student_id], references: [student_id])
  uploaded_at DateTime @default(now())
}
